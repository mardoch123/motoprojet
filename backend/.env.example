# ─── Base de données ──────────────────────────────────────────────────────────
# Neon PostgreSQL (récupérer depuis le dashboard Neon)
DATABASE_URL=postgresql://user:password@neon-host/dbname?sslmode=require

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Générer avec : node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=change-me-in-production-min-32-chars
JWT_REFRESH_SECRET=change-me-in-production-min-32-chars-different
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── Serveur ──────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── Chiffrement des données sensibles ────────────────────────────────────────
# Générer avec : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Min 32 caractères. Utilisé pour chiffrer les pièces d'identité en base.
ENCRYPTION_KEY=

# ─── Stockage objets (Cloudflare R2 / S3-compatible) ─────────────────────────
R2_ENDPOINT=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=motoprojet
R2_PUBLIC_URL=

# ─── SMS / WhatsApp ───────────────────────────────────────────────────────────
SMS_PROVIDER=log
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
WHATSAPP_ENABLED=false
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=

# ─── Intelligence Artificielle ────────────────────────────────────────────────
# Fournisseur principal : 'deepseek' ou 'claude'
IA_PROVIDER=deepseek

# Deepseek API
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Claude API (Anthropic) — fallback
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-20250514

# ─── KKiaPay (Mobile Money) ──────────────────────────────────────────────────
# Clé privée (serveur uniquement — jamais côté Flutter)
KKIAPAY_API_KEY=
# Clé publique (widget Flutter — récupérée depuis le dashboard KKiaPay)
KKIAPAY_PUBLIC_KEY=
KKIAPAY_API_URL=https://api.kkiapay.io
KKIAPAY_WEBHOOK_SECRET=
KKIAPAY_SANDBOX=true

# ─── Sentry (monitoring erreurs) ────────────────────────────────────────────────
# Récupérer le DSN depuis https://sentry.io → Settings → Client Keys
SENTRY_ENABLED=false
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
# Taux de sampling des transactions (0.1 = 10%, 1.0 = 100%)
SENTRY_TRACES_SAMPLE_RATE=0.2

# ─── Alertes monitoring ─────────────────────────────────────────────────────────
# Webhook Slack ou Discord pour alertes automatiques (pic erreurs, latence)
MONITORING_ALERT_WEBHOOK_URL=
# Email pour alertes critiques
MONITORING_ALERT_EMAIL_TO=
# Seuil de détection requête lente (ms)
MONITORING_SLOW_QUERY_MS=1000
# Seuil taux d'erreur HTTP 5xx (%) — alerte si dépassé
MONITORING_ERROR_RATE_THRESHOLD=5
# Seuil latence moyenne (ms) — alerte si dépassé
MONITORING_LATENCY_THRESHOLD_MS=3000
