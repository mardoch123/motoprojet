# =============================================================================
# Configuration Flutter — MotoProjet (Kɛkɛ ce) — EXEMPLE
# =============================================================================
# Copiez ce fichier vers .env et modifiez les valeurs :
#   cp .env.example .env
# =============================================================================

# ─── API Backend ──────────────────────────────────────────────────────────────
# URL de l'API backend
# Android emulator : http://10.0.2.2:3000
# iOS simulator    : http://localhost:3000
# Production       : https://motoprojet.fly.dev
API_BASE_URL=https://motoprojet.fly.dev

# Timeout des requêtes API (millisecondes)
API_TIMEOUT=30000

# ─── Sentry (monitoring erreurs) ─────────────────────────────────────────────
SENTRY_ENABLED=false
SENTRY_DSN=

# ─── KKiaPay (Mobile Money) ─────────────────────────────────────────────────
# Les clés KKiaPay sont gérées par le backend (backend/.env).
# L'app Flutter récupère la config via GET /kkiapay/config
# =============================================================================
