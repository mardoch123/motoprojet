# =============================================================================
# Configuration Flutter — MotoProjet (EXEMPLE)
# =============================================================================
# Copiez ce fichier vers .env et modifiez les valeurs :
#   cp .env.example .env
# =============================================================================

# URL de l'API backend
# Android emulator : http://10.0.2.2:3000
# iOS simulator    : http://localhost:3000
# Production       : https://votre-app.onrender.com
API_BASE_URL=https://motoprojet-api.onrender.com

# Timeout des requêtes API (millisecondes)
API_TIMEOUT=30000

# Sentry (monitoring erreurs)
SENTRY_ENABLED=false
SENTRY_DSN=
